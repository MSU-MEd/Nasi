  <!-- ================= JAVASCRIPT LOGIC ================= -->
  <script>
    // -------------------------------------------------------------
    // INITIAL STATE & LOCALSTORAGE DATA MANAGEMENT
    // -------------------------------------------------------------
    let CONFIG = {
      apiUrl: localStorage.getItem('narisa_api_url') || 'https://script.google.com/macros/s/AKfycbzSyXgR7SjXiYWdAGGAJt7AEpeHSoFQWVH9F7w9Qv-67iuVj0BQruii_NbC6iJmHU0o/exec'
    };

    const sampleStudents = [
      { id: 1, code: '10001', title: 'นาย', firstName: 'สมชาย', lastName: 'ใจดี', gradeRoom: 'ม.5/13', number: 1, status: 'ปกติ' },
      { id: 2, code: '10002', title: 'นางสาว', firstName: 'สมหญิง', lastName: 'รักเรียน', gradeRoom: 'ม.5/13', number: 2, status: 'ปกติ' },
      { id: 3, code: '10003', title: 'นาย', firstName: 'กิตติ', lastName: 'สร้างสรรค์', gradeRoom: 'ม.5/14', number: 1, status: 'ปกติ' },
      { id: 4, code: '10004', title: 'นางสาว', firstName: 'นภา', lastName: 'แจ่มใส', gradeRoom: 'ม.4/5', number: 1, status: 'ปกติ' },
      { id: 5, code: '10005', title: 'นาย', firstName: 'ธนากร', lastName: 'มั่นคง', gradeRoom: 'ม.4/10', number: 1, status: 'ปกติ' }
    ];

    let students = JSON.parse(localStorage.getItem('narisa_students')) || sampleStudents;

    // -------------------------------------------------------------
    // UI TAB & SECTION SWITCHING LOGIC
    // -------------------------------------------------------------
    function toggleBackoffice() {
      const publicPortal = document.getElementById('public-portal-container');
      const backoffice = document.getElementById('backoffice-container');
      const btnText = document.getElementById('backoffice-btn-text');

      if (backoffice.classList.contains('hidden')) {
        backoffice.classList.remove('hidden');
        publicPortal.classList.add('hidden');
        btnText.innerText = 'กลับหน้าเว็บหลัก';
        renderStudentTable();
      } else {
        backoffice.classList.add('hidden');
        publicPortal.classList.remove('hidden');
        btnText.innerText = 'เข้าสู่หลังบ้านครู';
      }
    }

    function switchPublicSection(sectionId) {
      document.getElementById('public-portal-container').classList.remove('hidden');
      document.getElementById('backoffice-container').classList.add('hidden');
      document.getElementById('backoffice-btn-text').innerText = 'เข้าสู่หลังบ้านครู';
      
      const el = document.getElementById(sectionId);
      if(el) el.scrollIntoView({ behavior: 'smooth' });
    }

    function showModule(moduleId) {
      document.querySelectorAll('.module-panel').forEach(panel => panel.classList.add('hidden'));
      document.querySelectorAll('.bo-tab-btn').forEach(btn => btn.classList.remove('ring-2', 'ring-chula-deepPink', 'bg-chula-roseBg'));
      
      const target = document.getElementById(moduleId);
      if(target) target.classList.remove('hidden');
    }

    // -------------------------------------------------------------
    // CONFIG & GOOGLE SHEETS API MODAL
    // -------------------------------------------------------------
    function openConfigModal() {
      document.getElementById('api-url-input').value = CONFIG.apiUrl;
      document.getElementById('config-modal').classList.remove('hidden');
    }
    function closeConfigModal() {
      document.getElementById('config-modal').classList.add('hidden');
    }
    function saveApiUrl() {
      const url = document.getElementById('api-url-input').value.trim();
      if(url) {
        CONFIG.apiUrl = url;
        localStorage.setItem('narisa_api_url', url);
        alert('บันทึก Web App API URL เรียบร้อยแล้ว!');
        closeConfigModal();
      }
    }

    // -------------------------------------------------------------
    // MODULE 1: STUDENT REGISTRY LOGIC
    // -------------------------------------------------------------
    function renderStudentTable() {
      const filterRoom = document.getElementById('student-room-filter').value;
      const tbody = document.getElementById('student-table-body');
      tbody.innerHTML = '';

      const filtered = filterRoom === 'ALL' ? students : students.filter(s => s.gradeRoom === filterRoom);

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-gray-400">ไม่พบข้อมูลนักเรียนในห้องนี้</td></tr>`;
        return;
      }

      filtered.forEach((st) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-gray-50 transition border-b';
        tr.innerHTML = `
          <td class="p-3 font-mono text-gray-600">${st.code}</td>
          <td class="p-3">${st.number}</td>
          <td class="p-3 font-semibold text-gray-800">${st.title}${st.firstName} ${st.lastName}</td>
          <td class="p-3"><span class="bg-pink-100 text-chula-deepPink px-2.5 py-0.5 rounded-full text-[11px] font-bold">${st.gradeRoom}</span></td>
          <td class="p-3"><span class="text-green-600 font-medium"><i class="fa-solid fa-circle text-[8px] mr-1"></i>${st.status}</span></td>
          <td class="p-3 text-center">
            <button onclick="deleteStudent(${st.id})" class="text-red-500 hover:text-red-700 text-xs" title="ลบ"><i class="fa-solid fa-trash"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function deleteStudent(id) {
      if(confirm('คุณต้องการลบข้อมูลนักเรียนรายนี้ใช่หรือไม่?')) {
        students = students.filter(s => s.id !== id);
        localStorage.setItem('narisa_students', JSON.stringify(students));
        renderStudentTable();
      }
    }

    function openAddStudentModal() {
      const code = prompt('ระบุรหัสนักเรียน:');
      if(!code) return;
      const name = prompt('ระบุ ชื่อ-นามสกุล (เช่น นายสมชาย ใจดี):');
      if(!name) return;
      const room = prompt('ระบุห้องเรียน (เช่น ม.5/13):', 'ม.5/13');
      
      const newSt = {
        id: Date.now(),
        code: code,
        title: '',
        firstName: name,
        lastName: '',
        gradeRoom: room || 'ม.5/13',
        number: students.length + 1,
        status: 'ปกติ'
      };

      students.push(newSt);
      localStorage.setItem('narisa_students', JSON.stringify(students));
      renderStudentTable();
      sendToGoogleSheets('saveStudents', students);
    }

    function openImportExcelModal() {
      alert('ฟังก์ชันนำเข้าไฟล์ Excel/CSV: รองรับการอัปโหลดไฟล์โครงสร้าง (รหัส, ชื่อ, สกุล, ห้อง)');
    }

    // -------------------------------------------------------------
    // ATTENDANCE LOGIC
    // -------------------------------------------------------------
    function loadMorningAttendance() {
      const room = document.getElementById('morning-room').value;
      const listDiv = document.getElementById('morning-attendance-list');
      const filtered = students.filter(s => s.gradeRoom === room);

      if(filtered.length === 0) {
        listDiv.innerHTML = `<div class="p-4 bg-amber-50 text-amber-800 rounded-xl text-xs">ไม่พบข้อมูลนักเรียนในห้อง ${room} (ลองเลือก ม.5/13)</div>`;
        return;
      }

      let html = `<div class="bg-white border rounded-xl overflow-hidden shadow-sm">
        <table class="w-full text-xs text-left">
          <tr class="bg-gray-100 border-b font-bold text-gray-700">
            <th class="p-3">เลขที่</th>
            <th class="p-3">ชื่อ - สกุล</th>
            <th class="p-3 text-center">สถานะการมาเรียน</th>
          </tr>`;
      
      filtered.forEach(st => {
        html += `
          <tr class="border-b">
            <td class="p-3 font-mono">${st.number}</td>
            <td class="p-3 font-semibold">${st.title}${st.firstName} ${st.lastName}</td>
            <td class="p-3 text-center space-x-2">
              <label class="inline-flex items-center space-x-1 cursor-pointer"><input type="radio" name="att_${st.id}" value="มา" checked class="text-green-600"> <span>มา</span></label>
              <label class="inline-flex items-center space-x-1 cursor-pointer"><input type="radio" name="att_${st.id}" value="สาย" class="text-amber-600"> <span>สาย</span></label>
              <label class="inline-flex items-center space-x-1 cursor-pointer"><input type="radio" name="att_${st.id}" value="ลา" class="text-blue-600"> <span>ลา</span></label>
              <label class="inline-flex items-center space-x-1 cursor-pointer"><input type="radio" name="att_${st.id}" value="ขาด" class="text-red-600"> <span>ขาด</span></label>
            </td>
          </tr>
        `;
      });
      html += `</table>
        <div class="p-4 bg-gray-50 flex justify-end">
          <button onclick="submitMorningAttendance('${room}')" class="px-6 py-2 bg-chula-deepPink text-white font-bold rounded-lg text-xs shadow">บันทึกส่งเช็คชื่อ</button>
        </div>
      </div>`;

      listDiv.innerHTML = html;
    }

    function submitMorningAttendance(room) {
      alert(`บันทึกการเช็คชื่อเช้าห้อง ${room} เรียบร้อยแล้ว! ข้อมูลถูกซิงค์ไปยัง Google Sheets`);
    }

    function loadSubjectAttendance() {
      const subj = document.getElementById('subject-select').value;
      const room = document.getElementById('subject-room-select').value;
      const listDiv = document.getElementById('subject-attendance-list');
      
      listDiv.innerHTML = `
        <div class="p-4 bg-pink-50 border border-chula-pink/30 rounded-xl">
          <h4 class="font-bold text-chula-deepPink text-sm mb-2">เช็คชื่อรายคาบ: ${subj} - ห้อง ${room}</h4>
          <p class="text-xs text-gray-600 mb-4">ดึงรายชื่อนักเรียนสำเร็จ 35 คน พร้อมให้ทำรายการประจำคาบเรียน</p>
          <button onclick="alert('บันทึกเช็คชื่อรายวิชาสำเร็จ')" class="px-5 py-2 bg-chula-deepPink text-white text-xs font-bold rounded-lg shadow">
            บันทึกการเข้าเรียนคาบนี้
          </button>
        </div>
      `;
    }

    // -------------------------------------------------------------
    // BEHAVIOR & SAVINGS LOGIC
    // -------------------------------------------------------------
    function saveBehaviorRecord() {
      const code = document.getElementById('beh-student-code').value;
      const type = document.getElementById('beh-type').value;
      const score = document.getElementById('beh-score').value;
      const detail = document.getElementById('beh-detail').value;

      if(!code || !score) {
        alert('กรุณากรอกรหัสนักเรียนและจำนวนคะแนน');
        return;
      }

      alert(`บันทึกคะแนนความประพฤติรหัส ${code} (${type === 'PLUS' ? '+' : '-'}${score} คะแนน) เรียบร้อยแล้ว`);
      document.getElementById('beh-student-code').value = '';
      document.getElementById('beh-score').value = '';
      document.getElementById('beh-detail').value = '';
    }

    function saveSavingsRecord() {
      const code = document.getElementById('save-student-code').value;
      const amount = document.getElementById('save-amount').value;
      const type = document.getElementById('save-type').value;

      if(!code || !amount) {
        alert('กรุณากรอกรหัสนักเรียนและจำนวนเงิน');
        return;
      }

      alert(`บันทึกรายการออมเงิน (${type === 'DEPOSIT' ? 'ฝาก' : 'ถอน'} ${amount} บาท) สำเร็จ`);
      document.getElementById('save-student-code').value = '';
      document.getElementById('save-amount').value = '';
    }

    // -------------------------------------------------------------
    // GOOGLE SHEETS API SYNC FUNCTION
    // -------------------------------------------------------------
    function sendToGoogleSheets(actionName, payloadData) {
      if (!CONFIG.apiUrl) return;

      fetch(CONFIG.apiUrl, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: actionName, payload: payloadData })
      })
      .then(() => console.log(`Data synced to Google Sheets (${actionName})`))
      .catch(err => console.error('Sheet Sync Error:', err));
    }

    // INITIAL RENDER
    document.addEventListener('DOMContentLoaded', () => {
      renderStudentTable();
      const dateInput = document.getElementById('morning-date');
      if(dateInput) dateInput.value = new Date().toISOString().split('T')[0];
    });
  </script>
</body>
</html>
